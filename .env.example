# Local development. The app opens at http://localhost:8080.
APP_HOST=http://localhost
HTTP_PORT=8080
HTTPS_PORT=8443
POSTGRES_DB=sleep
POSTGRES_USER=sleep
POSTGRES_PASSWORD=sleep
SLEEP_SEED_DEMO=false

# HTTP basic authentication in front of the whole site (web and /api).
# Local login: analyst / sleep-local. Keep the hash in single quotes:
# it contains "$" characters that Compose would otherwise interpolate.
BASIC_AUTH_USER=analyst
BASIC_AUTH_HASH='$2a$14$B0GrV.dM4y4rcJApy09Pkejt2PDmQYS9lsznEIRruasasp327nhDq'

# npm registry for building the web image. Leave unset to use
# registry.npmjs.org; set an npm-compatible mirror if downloads time out.
# NPM_REGISTRY=https://registry.npmjs.org/

# Production example:
# APP_HOST=app.sleep.example
# HTTP_PORT=80
# HTTPS_PORT=443
# POSTGRES_PASSWORD=replace-with-a-long-random-secret
# BASIC_AUTH_USER=replace-with-a-login
# BASIC_AUTH_HASH='output of: docker run --rm caddy:2-alpine caddy hash-password --plaintext "<password>"'
# Set SLEEP_SEED_DEMO=true only when local demo data is needed.
