{$APP_HOST:http://localhost} {
    encode zstd gzip

    # Temporary access boundary until the API has real authentication.
    # The API still trusts X-Organization-ID, so the whole site, including
    # /api, must stay closed to anonymous clients.
    basic_auth {
        {$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
    }

    handle_path /api/* {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy web:80
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
}
